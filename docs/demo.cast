{"version": 2, "width": 237, "height": 47, "timestamp": 1794978893, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.028919, "o", "\r\n# 1. one command builds the lab: one compute node, three VMs\r\n$ lab/lab.sh up\r\n"]
[0.556354, "o", "lab up: mvr-cn1 + mvr-vm1..3\r\n\r\n# 2. start the forwarder (lab/cn1.conf); it drops to nobody once it is set up\r\n$ lab/lab.sh run\r\n"]
[0.68557, "o", "forwarder running (pid 133511), log /home/tri/repo/greennode/build/lab/minivrd.log\r\nalias vrctl='/home/tri/repo/greennode/build/debug/vrctl -s /run/mvr-cn1/minivr.sock'    # or: export MINIVR_SOCK=/run/mvr-cn1/minivr.sock\r\n"]
[0.68908, "o", "$ grep -E \"^(Uid|CapEff|NoNewPrivs)\" /proc/<minivrd pid>/status\r\n"]
[0.68938, "o", "Uid:\t65534\t65534\t65534\t65534\r\nCapEff:\t0000000000000000\r\nNoNewPrivs:\t1\r\n"]
[0.689979, "o", "\r\n# 3. VMs reach each other through the forwarder (TTL 63 = one hop)\r\n$ [mvr-vm1] ping -c3 -W1 10.0.2.13\r\n"]
[0.695561, "o", "PING 10.0.2.13 (10.0.2.13) 56(84) bytes of data.\r\n"]
[0.697844, "o", "64 bytes from 10.0.2.13: icmp_seq=1 ttl=63 time=0.851 ms\r\n"]
[1.72166, "o", "64 bytes from 10.0.2.13: icmp_seq=2 ttl=63 time=0.123 ms\r\n"]
[2.74691, "o", "64 bytes from 10.0.2.13: icmp_seq=3 ttl=63 time=0.367 ms\r\n\r\n--- 10.0.2.13 ping statistics ---\r\n3 packets transmitted, 3 received, 0% packet loss, time 2050ms\r\nrtt min/avg/max/mdev = 0.123/0.447/0.851/0.302 ms\r\n"]
[2.753513, "o", "$ [mvr-vm1] ping -c2 -W1 10.0.1.12\r\n"]
[2.759092, "o", "PING 10.0.1.12 (10.0.1.12) 56(84) bytes of data.\r\n"]
[2.759607, "o", "64 bytes from 10.0.1.12: icmp_seq=1 ttl=63 time=0.234 ms\r\n"]
[3.770842, "o", "64 bytes from 10.0.1.12: icmp_seq=2 ttl=63 time=0.430 ms\r\n\r\n--- 10.0.1.12 ping statistics ---\r\n2 packets transmitted, 2 received, 0% packet loss, time 1011ms\r\nrtt min/avg/max/mdev = 0.234/0.332/0.430/0.098 ms\r\n"]
[3.77269, "o", "\r\n#    the gateway answers for itself, and ARP is answered by the forwarder\r\n$ [mvr-vm1] ping -c1 -W1 10.0.1.1\r\n"]
[3.782785, "o", "PING 10.0.1.1 (10.0.1.1) 56(84) bytes of data.\r\n64 bytes from 10.0.1.1: icmp_seq=1 ttl=64 time=0.081 ms\r\n\r\n--- 10.0.1.1 ping statistics ---\r\n1 packets transmitted, 1 received, 0% packet loss, time 0ms\r\nrtt min/avg/max/mdev = 0.081/0.081/0.081/0.000 ms\r\n"]
[3.787986, "o", "\r\n# 4. inspect state\r\n$ build/debug/vrctl route show\r\n"]
[3.794689, "o", "PREFIX          PORT  GATEWAY     ORIGIN\r\n10.0.1.0/24     -     -           connected\r\n10.0.1.11/32    p1    -           host\r\n10.0.1.12/32    p2    -           host\r\n10.0.2.0/24     p3    -           connected\r\n10.0.2.13/32    p3    -           host\r\n$ build/debug/vrctl neigh show\r\n"]
[3.795549, "o", "IP              MAC                PORT  KIND     STATE       HELD"]
[3.796582, "o", "\r\n10.0.1.11       02:00:00:00:01:01  p1    static   REACHABLE   0\r\n10.0.1.12       02:00:00:00:01:02  p2    static   REACHABLE   0\r\n10.0.2.13       02:00:00:00:01:03  p3    static   REACHABLE   0\r\n$ build/debug/vrctl port show\r\n"]
[3.801461, "o", "NAME  IFNAME  MAC                IP               MTU   ADMIN OPER     RX_PKTS    RX_BYTES   TX_PKTS    TX_BYTES   DROPS\r\np1    p1      02:00:00:00:00:01  10.0.1.1/24      1500  up    up             8         672         8         672       0\r\np2    p2      02:00:00:00:00:02  10.0.1.1/24      1500  up    up             3         238         3         238       0\r\np3    p3      02:00:00:00:00:03  10.0.2.1/24      1500  up    up             4         336         4         336       0\r\n"]
[3.802227, "o", "\r\n# 5. change routes while traffic flows (no restart)\r\n$ [mvr-vm3] ip addr add 10.0.9.1/32 dev lo\r\n"]
[3.812822, "o", "$ lab/lab.sh run --config lab/cn1-nobind.conf\r\n"]
[4.085451, "o", "forwarder running (pid 133554), log /home/tri/repo/greennode/build/lab/minivrd.log\r\nalias vrctl='/home/tri/repo/greennode/build/debug/vrctl -s /run/mvr-cn1/minivr.sock'    # or: export MINIVR_SOCK=/run/mvr-cn1/minivr.sock\r\n"]
[4.08611, "o", "$ build/debug/vrctl route add 10.0.9.0/24 dev p3 via 10.0.2.13\r\n"]
[4.08932, "o", "ok\r\n"]
