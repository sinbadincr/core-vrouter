[8.515457, "o", "\r\n# 4. TTL 1 expires at the forwarder; an unknown network is unreachable\r\n$ [vm1] ping -c1 -t1 -W2 10.0.2.13\r\n"]
[8.620844, "o", "PING 10.0.2.13 (10.0.2.13) 56(84) bytes of data.\r\nFrom 10.0.1.1 icmp_seq=1 Time to live exceeded\r\n\r\n--- 10.0.2.13 ping statistics ---\r\n1 packets transmitted, 0 received, +1 errors, 100% packet loss, time 0ms\r\n\r\n"]
[8.621963, "o", "$ [vm1] ping -c1 -W2 10.9.9.9\r\n"]
[8.697964, "o", "PING 10.9.9.9 (10.9.9.9) 56(84) bytes of data.\r\nFrom 10.0.1.1 icmp_seq=1 Destination Net Unreachable\r\n\r\n--- 10.9.9.9 ping statistics ---\r\n1 packets transmitted, 0 received, +1 errors, 100% packet loss, time 0ms\r\n\r\n"]
[8.69945, "o", "\r\n# 5. a spoofed source address is dropped and counted\r\n$ [vm1] sudo ip addr add 10.0.1.12/32 dev eth0\r\n"]
[8.797062, "o", "$ [vm1] ping -c3 -W1 -I 10.0.1.12 10.0.2.13\r\n"]
[11.915263, "o", "PING 10.0.2.13 (10.0.2.13) from 10.0.1.12 : 56(84) bytes of data.\r\n\r\n--- 10.0.2.13 ping statistics ---\r\n3 packets transmitted, 0 received, 100% packet loss, time 2040ms\r\n\r\n"]
[11.9177, "o", "$ [vm1] sudo ip addr del 10.0.1.12/32 dev eth0\r\n"]
[12.012363, "o", "$ build/debug/vrctl -j stats show | jq .data.drops.reasons.source_spoofed\r\n"]
[12.01425, "o", "\u001b[0;39m3\u001b[0m\r\n"]
[12.014518, "o", "\r\n# 6. change routes while traffic flows (no restart; same forwarder pid)\r\n"]
[12.015419, "o", "$ forwarder pid: 48750\r\n$ [vm3] sudo ip addr add 10.0.9.1/32 dev lo\r\n"]
[12.095278, "o", "$ build/debug/vrctl route add 10.0.9.0/24 dev p3 via 10.0.2.13\r\nok\r\n"]
[12.095439, "o", "$ [vm1] ping -c1 -W2 10.0.9.1\r\n"]
