[4.261524, "o", "\r\n# 3. guests reach each other through the forwarder (TTL 63 = one hop)\r\n"]
[4.26156, "o", "$ [vm1] sudo ping -c3 -W1 10.0.2.13\r\n"]
[4.466711, "o", "PING 10.0.2.13 (10.0.2.13) 56(84) bytes of data.\r\n64 bytes from 10.0.2.13: icmp_seq=1 ttl=63 time=134 ms\r\n"]
[5.338992, "o", "64 bytes from 10.0.2.13: icmp_seq=2 ttl=63 time=0.601 ms\r\n"]
[6.364025, "o", "64 bytes from 10.0.2.13: icmp_seq=3 ttl=63 time=1.18 ms\r\n"]
