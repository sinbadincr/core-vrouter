[4.124204, "o", "\r\n# 6. malformed traffic: every frame lands in a named drop reason\r\n$ build/debug/vrctl stats clear\r\n"]
[4.12738, "o", "ok\r\n"]
[4.127965, "o", "$ .venv/bin/python tests/e2e/corpus.py --ns mvr-vm1 --count 3\r\n"]
[7.398764, "o", "{\"expected\": {\"truncated\": 3, \"bad_ip_version\": 3, \"bad_ip_hdr_len\": 6, \"ip_options\": 3, \"bad_ip_total_len\": 6, \"bad_ip_checksum\": 3, \"ip_fragment\": 6, \"unsupported_ethertype\": 6, \"non_arp_bcast_mcast\": 6, \"not_for_us_l2\": 3, \"bad_arp\": 15, \"arp_unknown_target\": 3, \"source_spoofed\": 12}, \"sent\": 75}\r\n"]
[7.47729, "o", "$ build/debug/vrctl -j stats show | jq .data.drops\r\n"]
[7.481159, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"total\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m75\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"reasons\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"truncated\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m3\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"bad_ip_version\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m3\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"bad_ip_hdr_len\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m6\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"ip_options\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m3\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"bad_ip_total_len\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m6\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"bad_ip_checksum\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m3\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"ip_fragment\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m6\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"unsupported_ethertype\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m6\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"non_arp_bcast_mcast\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m6\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"not_for_us_l2\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m3\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"bad_arp\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m15\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"arp_unknown_target\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m3\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"source_spoofed\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m12\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
