{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {"name": "base", "hidden": true, "generator": "Unix Makefiles",
     "binaryDir": "${sourceDir}/build/${presetName}"},
    {"name": "debug", "inherits": "base",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "CMAKE_C_FLAGS": "-O0 -g3"}},
    {"name": "release", "inherits": "base",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "CMAKE_C_FLAGS": "-O2 -g"}},
    {"name": "asan", "inherits": "base",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug",
       "CMAKE_C_FLAGS": "-O1 -g3 -fsanitize=address,undefined -fno-sanitize-recover=all"}},
    {"name": "tsan", "inherits": "base",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "CMAKE_C_FLAGS": "-O1 -g3 -fsanitize=thread"}},
    {"name": "clang-debug", "inherits": "debug",
     "cacheVariables": {"CMAKE_C_COMPILER": "clang"}},
    {"name": "clang-asan", "inherits": "asan",
     "cacheVariables": {"CMAKE_C_COMPILER": "clang"}}
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug"},
    {"name": "release", "configurePreset": "release"},
    {"name": "asan", "configurePreset": "asan"},
    {"name": "tsan", "configurePreset": "tsan"},
    {"name": "clang-debug", "configurePreset": "clang-debug"},
    {"name": "clang-asan", "configurePreset": "clang-asan"}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "asan", "configurePreset": "asan", "output": {"outputOnFailure": true}},
    {"name": "tsan", "configurePreset": "tsan", "output": {"outputOnFailure": true}},
    {"name": "clang-asan", "configurePreset": "clang-asan", "output": {"outputOnFailure": true}}
  ]
}
